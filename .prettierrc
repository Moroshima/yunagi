{
  "endOfLine": "auto",
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-packagejson",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "<TYPES>^(node:)",
    "<TYPES>",
    "<TYPES>^[.]",
    "^eslint$",
    "^eslint(/.*)$",
    "^eslint-(.*)(/.*)$",
    "<BUILTIN_MODULES>",
    "^react$",
    "^next$",
    "^next(/.*)$",
    "<THIRD_PARTY_MODULES>",
    "^@(?!components|data|hooks|styles|utils)(.*)(/.*)$",
    "^@(components|data|hooks|styles|utils)(/.*)$",
    "^@(/.*)$",
    "^[.]",
    "^(?!.*[.]scss$)[./].*$",
    ".scss$"
  ]
}
